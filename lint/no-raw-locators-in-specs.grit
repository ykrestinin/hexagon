// Specs talk to the UI only through page objects and controls.
`$_.$method($...)` where {
  $method <: or {
    `getByTestId`,
    `getByRole`,
    `getByLabel`,
    `getByText`,
    `getByPlaceholder`,
    `locator`,
    `$`,
    `$$`
  },
  register_diagnostic(span=$method, message="Raw locator in a spec: route it through a page object or control.", severity="error")
}
